# 키 이름만 커밋한다. 실값은 Railway 환경변수로만 주입 (ADR-006 운영 1 / ADR-007 §7).
# 로컬은 compose.yaml + spring-boot-docker-compose 자동 발견을 쓰므로 DB_* 는 배포에서만 필요하다.

# DB (배포 전용)
DB_URL=
DB_USER=
DB_PASSWORD=

# JWT — HS256. 32바이트(256bit) 미만이면 기동 시점에 거부된다.
#   생성: openssl rand -base64 48
JWT_SECRET=

# CORS 허용 오리진. 콤마로 여러 개 지정 가능 (Vercel preview + prod).
ALLOWED_ORIGIN=

# 건축HUB 건축물대장 OpenAPI (공공데이터포털 15134735) — pipeline 표제부·전유부 수집.
#   END_POINT 예: https://apis.data.go.kr/1613000/BldRgstHubService/getBrTitleInfo
#   SERVICE_KEY 는 인코딩·디코딩 어느 형태로 넣어도 된다 (apiclient 가 정규화한다).
END_POINT=
SERVICE_KEY=

# VWorld 지오코더 API 키 (vworld.kr) — pipeline 좌표·행정동코드 취득.
VWORLD_KEY=
